# PostgreSQL
POSTGRES_DB=callbot
POSTGRES_USER=callbot
POSTGRES_PASSWORD=callbot
POSTGRES_PORT=5432

# Application
SERVER_PORT=8080

# Security (use a long random value in production, min 32 bytes)
JWT_SECRET=dev-secret-change-me-please-32bytes-minimum-required
JWT_EXPIRATION_MS=86400000

# API key for the AI call microservice (X-Api-Key header). Empty = service auth disabled.
SERVICE_API_KEY=dev-service-key-change-me

# Discord
DISCORD_WEBHOOK_CLIENT=xxxxxx
DISCORD_WEBHOOK_RESTAURANT=xxxxxx

# Frontend base URL
FRONTEND_BASE_URL=xxxxxx
# Payment provider adapter to activate (stripe by default).
PAYMENT_PROVIDER=stripe

# Stripe (offer checkout). Empty STRIPE_SECRET_KEY disables checkout (502 on call).
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:4200/offre/success
STRIPE_CANCEL_URL=http://localhost:4200/offre
# Recurring Price id for the "pro" offer (created in Stripe). Empty = inline price fallback.
STRIPE_PRO_PRICE_ID=price_1TvZu0IPhZGdIoYxrnAyEzyS
# Webhook signing secret (whsec_...) from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Stripe Connect (paiements convives : acompte, complement, no-show) ---
# Les evenements Connect arrivent sur /api/payments/webhook, un endpoint distinct
# de /api/offers/webhook : Stripe signe chaque endpoint avec SON PROPRE secret.
# Vide = toute notification de paiement convive est rejetee (aucune resa ne passe
# en "secured"). En local :
#   stripe listen --forward-connect-to http://localhost:8080/api/payments/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=
# Retours d'onboarding du restaurateur (back-office).
STRIPE_CONNECT_RETURN_URL=http://localhost:4200/parametres/paiements?onboarding=done
STRIPE_CONNECT_REFRESH_URL=http://localhost:4200/parametres/paiements?onboarding=refresh
# Pages ou atterrit le convive apres (ou au lieu de) payer.
STRIPE_CONNECT_SUCCESS_URL=http://localhost:4200/client/reservations/payee
STRIPE_CONNECT_TOP_UP_SUCCESS_URL=http://localhost:4200/client/reservations/complement-regle
STRIPE_CONNECT_CANCEL_URL=http://localhost:4200/client/reservations/paiement-annule
# Pays des comptes Connect crees pour les restaurateurs.
STRIPE_CONNECT_COUNTRY=FR

# --- Jobs planifies (valeurs par defaut dans application.yml) ---
# Reversement nocturne des frais de reservation collectes.
PAYOUT_CRON=0 15 4 * * *
# Frequence de tentative des penalites no-show hors delai d'annulation.
NO_SHOW_CHARGE_SCAN_INTERVAL_MS=600000
# Passe nocturne qui oublie les cartes des services ne pouvant plus etre debites.
NO_SHOW_DETACH_CRON=0 45 4 * * *

# Niveau de log applicatif (com.callbot.ai).
LOG_LEVEL=INFO

# CORS: frontend origins allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:4200
