# PostgreSQL
POSTGRES_DB=callbot
POSTGRES_USER=callbot
POSTGRES_PASSWORD=callbot
POSTGRES_PORT=5432

# Application
SERVER_PORT=8080

# Security (use a long random value in production, min 32 bytes)
JWT_SECRET=dev-secret-change-me-please-32bytes-minimum-required
JWT_EXPIRATION_MS=86400000

# API key for the AI call microservice (X-Api-Key header). Empty = service auth disabled.
SERVICE_API_KEY=dev-service-key-change-me

# Discord
DISCORD_WEBHOOK_CLIENT=xxxxxx
DISCORD_WEBHOOK_RESTAURANT=xxxxxx

# Frontend base URL
FRONTEND_BASE_URL=xxxxxx

# Voyage AI (embeddings de la base de connaissances). Vide = embeddings factices hors ligne.
VOYAGE_API_KEY=
